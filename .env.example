# Configurações do Supabase
VITE_SUPABASE_URL=https://sua-url-do-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=seu-token-anonimo-do-supabase

# === Notificações Inteligentes (Story 1.5) ===
# Chave pública VAPID para Web Push (segura para expor no frontend).
# Gere o par de chaves com `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=

# As variáveis abaixo NÃO vão neste arquivo em produção — são segredos da
# Edge Function `process-notification-deliveries`, configurados via
# `supabase secrets set NOME=valor` (nunca em .env do frontend, nunca commitados).
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@suaempresa.com
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=notificacoes@seudominio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# === AIOX Variables (added 2026-07-02) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API Key - usado somente localmente pela Edge Function. Em produção,
# configure com `supabase secrets set OPENAI_API_KEY=...`; nunca use VITE_OPENAI_API_KEY.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Allowlist CORS opcional do ai-gateway, separada por vírgulas. Configure como
# secret/env da Edge Function; provider, modelo, limites e kill switches ficam
# nas tabelas backend protegidas criadas pela migration da Story 1.20.
# AI_ALLOWED_ORIGINS=https://app.seudominio.com
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management API — usado apenas pelos scripts locais run_schema.mjs / test_mgmt.mjs.
# Dá acesso total ao projeto: mantenha somente no .env local, nunca commitado.
# Crie o token em https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Ref do projeto (o subdomínio de VITE_SUPABASE_URL)
SUPABASE_PROJECT_REF=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
AIOX_VERSION=5.2.9
